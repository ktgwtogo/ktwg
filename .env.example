# ─────────────────────────────────────────────────────────────
# KTGW Togo — variables d'environnement
# Copier ce fichier en `.env.local` (jamais commité) et remplir les valeurs.
# Les variables préfixées NEXT_PUBLIC_ sont exposées au navigateur :
# n'y mettez JAMAIS de secret.
# ─────────────────────────────────────────────────────────────

# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ Secret serveur uniquement — ne jamais importer côté client
SUPABASE_SERVICE_ROLE_KEY=

# Resend — e-mails transactionnels
RESEND_API_KEY=
EMAIL_FROM=contact@ktgw-togo.org
# Adresse(s) de l'équipe qui reçoit les notifications (séparées par des virgules)
EMAIL_TEAM=

# Cloudflare Turnstile — anti-spam des formulaires
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# E-mail Google du premier super administrateur
SUPER_ADMIN_EMAIL=

# Secret partagé pour sécuriser les routes /api/cron (Vercel Cron)
CRON_SECRET=

# SasPay : secret de signature du webhook (tableau de bord SasPay → Webhooks), URL https://www.ktgw.tg/api/webhooks/saspay
SASPAY_WEBHOOK_SECRET=
